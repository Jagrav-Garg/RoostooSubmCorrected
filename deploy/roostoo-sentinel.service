[Unit]
Description=Roostoo Sentinel autonomous competition bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# User can be 'ubuntu' (Ubuntu AMI) or 'ec2-user' (Amazon Linux 2023 AMI)
User=ubuntu
WorkingDirectory=/home/ubuntu/roostoo_sentinel
EnvironmentFile=/home/ubuntu/roostoo_sentinel/.env
# Use --mode live for live trading; --mode paper for simulated trading
ExecStart=/home/ubuntu/roostoo_sentinel/.venv/bin/python -m sentinel run --mode live
Restart=on-failure
RestartSec=30
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
