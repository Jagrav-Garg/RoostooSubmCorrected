[Unit]
Description=Roostoo Tick Candidate autonomous competition bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/roostoo_sentinel
EnvironmentFile=/home/ubuntu/roostoo_sentinel/.env
# Start in shadow mode. Use paper-exchange for the small-order verification stage.
ExecStart=/home/ubuntu/roostoo_sentinel/.venv/bin/python -m sentinel tick-run --mode shadow
Restart=on-failure
RestartSec=30
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
